# Normalize line endings: text files are stored and checked out with LF,
# on every operating system. Shell scripts and files mounted into Linux
# containers break with Windows CRLF line endings.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never modify, never diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.pbix binary
*.abf  binary
