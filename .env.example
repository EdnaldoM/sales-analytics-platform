# Local configuration template. Copy it and set your own values:
#   cp .env.example .env
# .env is git-ignored and must never be committed.
# Tip: generate random passwords with `openssl rand -hex 16`.

# ---------------------------------------------------------------
# PostgreSQL (operational sources): infrastructure/postgres/
# Passwords are applied only when the database volume is created.
# After changing them, recreate the volume (make reset).
# ---------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me
GENERATOR_PASSWORD=change-me
AIRBYTE_READER_PASSWORD=change-me

# ---------------------------------------------------------------
# Data generator: data_generator/
# Same seed + same anchor date = identical historical data.
# Leave empty to use the defaults (42 and 2026-11-22).
# ---------------------------------------------------------------
GENERATOR_SEED=
GENERATOR_ANCHOR_DATE=

# ---------------------------------------------------------------
# Airbyte API (Terraform: infrastructure/airbyte/; Airflow in Stage 6)
# Client id and secret: `make airbyte-credentials`.
# Workspace id: in the Airbyte web UI URL, /workspaces/<id>/...
# ---------------------------------------------------------------
AIRBYTE_WORKSPACE_ID=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# ---------------------------------------------------------------
# Snowflake (infrastructure/snowflake/)
# Account identifier: <orgname>-<accountname> (Snowsight: Account > View account details).
# The AIRBYTE_SVC private key is read from ~/.snowflake/keys/airbyte_svc.p8,
# never from this file.
# ---------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
